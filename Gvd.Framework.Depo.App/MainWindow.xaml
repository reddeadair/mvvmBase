<controls:GvdWindow x:Class="DepoSample.MainWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Gvd.Framework.Wpf.Controls;assembly=Gvd.Framework.Wpf"
                    xmlns:icons="clr-namespace:Gvd.Framework.Wpf.Icons;assembly=Gvd.Framework.Wpf"
                    xmlns:workspace="clr-namespace:Gvd.Framework.Wpf.Workspace;assembly=Gvd.Framework.Wpf"
                    xmlns:local="clr-namespace:DepoSample"
                    xmlns:core="clr-namespace:DepoSample;assembly=Gvd.Framework.Depo.Core"
                    Title="Depo Envanteri"
                    Width="1200"
                    Height="760"
                    WindowStartupLocation="CenterScreen">

    <!-- Başlık çubuğundaki düğme açık ve koyu tema arasında geçer -->
    <controls:GvdWindow.TitleBarContent>
        <Button Click="ThemeButton_Click"
                Style="{StaticResource Gvd.TitleBarButton}"
                ToolTip="Açık / koyu tema"
                controls:ControlHelper.Icon="{x:Static icons:GvdIcons.Moon}" />
    </controls:GvdWindow.TitleBarContent>

    <controls:GvdWindow.Resources>
        <!--
            Formlar. Workspace seçili düğümün ViewModel'ini gösterir. WPF, ViewModel'in tipine uyan DataTemplate'i seçer.
            Şablon yoksa formda yalnızca tipin adı görünür. Yeni düğüm tipi için buraya bir satır ekle.
            ViewModel'ler Core projesindedir. Bu yüzden "core" önekini kullan. Formlar bu projededir: "local" öneki.
        -->
        <DataTemplate DataType="{x:Type core:WarehouseViewModel}">
            <local:WarehouseView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type core:ShelfViewModel}">
            <local:ShelfView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type core:ProductViewModel}">
            <local:ProductView />
        </DataTemplate>
    </controls:GvdWindow.Resources>

    <!-- Hazır workspace ekranı: solda ağaç, ortada form, altta Durum paneli. DataContext: HierarchyWorkspace -->
    <!-- Title ve RootUnit sol panelin başlığıdır ("Depolar 2 depo"). -->
    <workspace:HierarchyWorkspaceView RootUnit="depo" Title="Depolar" />
</controls:GvdWindow>
