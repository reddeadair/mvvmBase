<UserControl controls:FormField.LabelType="{x:Type core:ShelfDto}" x:Class="DepoSample.ShelfView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Gvd.Framework.Wpf.Controls;assembly=Gvd.Framework.Wpf"
             xmlns:res="clr-namespace:Gvd.Framework.Wpf.Markup;assembly=Gvd.Framework.Wpf"
             xmlns:local="clr-namespace:DepoSample"
             xmlns:core="clr-namespace:DepoSample;assembly=Gvd.Framework.Depo.Core">
    <!-- Raf formu. DataContext: ShelfViewModel. Ürünü ağaçta rafın "+" menüsünden ekle. -->
    <StackPanel>
        <GroupBox Header="{res:Label BasicInfo, Type={x:Type local:ShelfView}}">
            <controls:FormPanel>
                <controls:TextField DataContext="{Binding Code}" />
                <controls:TextField DataContext="{Binding MaxLoad}" Unit="kg" />
            </controls:FormPanel>
        </GroupBox>
    </StackPanel>
</UserControl>
