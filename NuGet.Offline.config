<?xml version="1.0" encoding="utf-8"?>
<!--
  Paket kaynakları (internetsiz bilgisayar). NuGet bu dosyayı kendiliğinden okumaz. Komutta adıyla ver:
  dotnet restore Gvd.Framework.Depo.Tests --configfile NuGet.Offline.config
  - gvd: bu klasördeki _packages klasörü. Gvd.Framework paketleri buradadır.
  - gvd-offline: bu klasördeki _offline/feed klasörü. Bağımlılıkları gvdframeworka deposunun _offline/feed klasöründen kopyala.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="gvd" value="_packages" />
    <add key="gvd-offline" value="_offline/feed" />
  </packageSources>
</configuration>
