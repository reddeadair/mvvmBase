<?xml version="1.0" encoding="utf-8"?>
<!--
  Paket kaynakları (internetli bilgisayar):
  - gvd: bu klasördeki _packages klasörü. Gvd.Framework paketlerini buraya kopyala (README.md "Kurulum").
  - nuget.org: bağımlılıklar (FluentValidation, DI, xUnit).
-->
<configuration>
  <packageSources>
    <clear />
    <add key="gvd" value="_packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
